# ── LLM Providers ──

# Free tier — at least GEMINI_API_KEY is required
GEMINI_API_KEY=your_gemini_key          # https://aistudio.google.com/apikey (free, 25-1500 RPD)
GROQ_API_KEY=your_groq_key              # https://console.groq.com (free, 1000 RPD)
SAMBANOVA_API_KEY=your_sambanova_key    # https://cloud.sambanova.ai (free, 30 RPM)

# Paid providers — optional, for higher writing quality
OPENCODE_API_KEY=your_opencode_key      # https://opencode.go (Kimi K2.6)
OPENROUTER_API_KEY=your_or_key          # https://openrouter.ai/keys (DeepSeek V4 Flash, Qwen 3.5)

# Per-stage LLM routing is fixed in modules/llm_client.py::STAGE_ROUTES: every
# stage uses the OpenRouter gateway with one primary plus at most one declared
# fallback. A stage can be overridden with its own prefix, e.g.
#   TAILOR_MODEL=openai/gpt-6-luna
#   FIT_MODEL=z-ai/glm-5.3-flash
# Prefixes: FIT_ JD_ TAILOR_ REVIEWER_ ATS_ QA_ INTERVIEW_
# Vars per prefix: _PROVIDER, _MODEL, _FALLBACK_PROVIDER, _FALLBACK_MODEL,
#                  _REASONING_EFFORT, _FALLBACK_REASONING_EFFORT
# Setting <PREFIX>_FALLBACK_MODEL='' disables that stage's fallback.
# The retired WRITING_PROVIDER / WRITING_MODEL / GEMINI_WRITING_MODEL /
# LLM_PROVIDER vars no longer select writing models.

# Notion Integration
NOTION_TOKEN=your_notion_token
NOTION_APPLICATIONS_DB_ID=your_db_id
NOTION_MASTER_RESUME_ID=your_resume_page_id
NOTION_QA_TEMPLATES_DB_ID=your_qa_db_id
NOTION_SKILLS_KEYWORDS_DB_ID=your_skills_db_id

# Applicant Info (for forms)
APPLICANT_NAME=Your Name
APPLICANT_EMAIL=your@email.com
APPLICANT_PHONE=+1234567890
APPLICANT_LINKEDIN=https://linkedin.com/in/yourprofile
APPLICANT_LOCATION=City, Country
